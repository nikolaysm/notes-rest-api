# Root Environment Variables Template
# Copy this file to create your .env files in each backend directory

# ===========================================
# NOTES BACKEND (.env)
# ===========================================
# MONGODB_INITDB_ROOT_USERNAME=root
# MONGODB_INITDB_ROOT_PASSWORD=your_root_password_here
# NOTES_DB_USER=notes_user
# NOTES_DB_PASSWORD=your_notes_password_here
# NOTES_DB_NAME=notes_db

# ===========================================
# NOTEBOOKS BACKEND (.env)
# ===========================================
# MONGODB_INITDB_ROOT_USERNAME=root
# MONGODB_INITDB_ROOT_PASSWORD=your_root_password_here
# NOTEBOOKS_DB_USER=notebooks_user
# NOTEBOOKS_DB_PASSWORD=your_notebooks_password_here
# NOTEBOOKS_DB_NAME=notebooks_db

# ===========================================
# SECURITY NOTES
# ===========================================
# - Use strong, unique passwords for each service
# - Never commit .env files to version control
# - Consider using Docker secrets for production
# - Rotate passwords regularly