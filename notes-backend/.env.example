# MongoDB Configuration for Notes Service
# Root credentials for MongoDB instance
MONGODB_INITDB_ROOT_USERNAME=root
MONGODB_INITDB_ROOT_PASSWORD=your_root_password_here

# Notes database user credentials
NOTES_DB_USER=notes_user
NOTES_DB_PASSWORD=your_notes_password_here
NOTES_DB_NAME=notes_db

# Optional: Application specific environment variables
# PORT=3000
# NODE_ENV=development
# NOTEBOOKS_API_URL=http://notebooks:80/api/notebooks