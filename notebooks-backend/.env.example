# MongoDB Configuration for Notebooks Service
# Root credentials for MongoDB instance
MONGODB_INITDB_ROOT_USERNAME=root
MONGODB_INITDB_ROOT_PASSWORD=your_root_password_here

# Notebooks database user credentials
NOTEBOOKS_DB_USER=notebooks_user
NOTEBOOKS_DB_PASSWORD=your_notebooks_password_here
NOTEBOOKS_DB_NAME=notebooks_db

# Optional: Application specific environment variables
# PORT=3000
# NODE_ENV=development